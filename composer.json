{
    "name": "maniaba/shield-ldap",
    "description": "LDAP and Active Directory authentication for CodeIgniter Shield",
    "type": "library",
    "license": "MIT",
    "keywords": ["codeigniter4", "shield", "ldap", "active-directory", "authentication"],
    "support": {
        "issues": "https://github.com/maniaba/shield-ldap/issues",
        "source": "https://github.com/maniaba/shield-ldap"
    },
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": ">=4.3.5 <4.5.0 || ^4.5.1",
        "codeigniter4/shield": "^1.4.1"
    },
    "require-dev": {
        "boundwize/pyrameter": "^0.5",
        "boundwize/structarmed": "^0.22",
        "codeigniter/phpstan-codeigniter": "^2.0",
        "codeigniter4/devkit": "^1.3",
        "infection/infection": "^0.32 || ^0.35",
        "mikey179/vfsstream": "^1.6.7",
        "phpstan/phpstan-strict-rules": "^2.0",
        "roave/security-advisories": "dev-latest"
    },
    "suggest": {
        "ext-ldap": "Required for the native LDAP transport. Custom directory providers can supply their own transport."
    },
    "autoload": {
        "psr-4": {
            "Maniaba\\ShieldLDAP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Maniaba\\ShieldLDAP\\Tests\\Support\\": "tests/_support/",
            "Maniaba\\ShieldLDAP\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "analyze": [
            "@phpstan:check",
            "psalm",
            "rector process --dry-run"
        ],
        "ci": [
            "Composer\\Config::disableProcessTimeout",
            "@cs",
            "@inspect",
            "@analyze",
            "@test"
        ],
        "cs": "php-cs-fixer fix --ansi --verbose --dry-run --diff",
        "cs-fix": "php-cs-fixer fix --ansi --verbose --diff",
        "inspect": "structarmed analyze",
        "mutation:check": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv PYRAMETER_DISABLED=1",
            "infection --static-analysis-tool=phpstan --with-uncovered"
        ],
        "phpstan:check": "phpstan analyse --ansi --verbose",
        "test": "phpunit",
        "test:ldap": [
            "Composer\\Config::disableProcessTimeout",
            "bash tests/_support/LDAP/run-integration-tests.sh"
        ]
    }
}
